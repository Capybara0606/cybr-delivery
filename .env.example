# Configuración por instalación: proyecto Supabase dedicado de desarrollo/demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor, nunca NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Seleccionar proveedor de mapas antes de Fase 6
NEXT_PUBLIC_MAP_STYLE_URL=

# Identidad de esta instalación (UUID del restaurante creado por seed o migración propia)
RESTAURANT_ID=a0000000-0000-4000-8000-000000000001
# Secreto estable de al menos 32 caracteres. Generar con un gestor seguro; nunca NEXT_PUBLIC_.
ORDER_TOKEN_SECRET=
# netlify | vercel | cloudflare; vacío usa un límite compartido conservador. Solo confiar en el proxy real.
TRUST_PROXY=
# Por defecto deshabilitado. Habilitar únicamente en negocio is_demo=true para pruebas identificadas.
NEXT_PUBLIC_ENABLE_GPS_SIMULATION=false
# Nombre público; cambiar junto con nombre/branding del negocio en configuración/DB.
NEXT_PUBLIC_RESTAURANT_NAME=Café Aurora
# Autoriza exclusivamente la limpieza de datos temporales del cron diario.
CRON_SECRET=
